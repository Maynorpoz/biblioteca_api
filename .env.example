# Entorno: development | test | production
NODE_ENV=development

# Puerto donde escucha la API
PORT=3000

# Conexión a PostgreSQL
# Formato: postgres://USUARIO:CONTRASEÑA@HOST:PUERTO/BASE_DE_DATOS
# (valores de ejemplo, cámbialos en tu .env)
DATABASE_URL=postgres://biblioteca_user:cambiar_esta_clave@localhost:5433/biblioteca_db

# Credenciales que usa docker-compose.yml para crear la base de datos
POSTGRES_USER=biblioteca_user
POSTGRES_PASSWORD=cambiar_esta_clave
POSTGRES_DB=biblioteca_db
# Puerto del host donde se expone PostgreSQL (debe coincidir con DATABASE_URL)
POSTGRES_PORT=5433
